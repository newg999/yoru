# ============================================================================
#  swaylock — pantalla de bloqueo (Mod+BackSpace)
#  Referencia: man swaylock
#  Truco: para un bloqueo con fondo desenfocado y reloj, mira "swaylock-effects"
#  o "hyprlock" en la hoja de ruta (ROADMAP.md).
# ============================================================================

daemonize
ignore-empty-password
show-failed-attempts
indicator-caps-lock

color=1a1b1e
indicator-radius=110
indicator-thickness=8

inside-color=1a1b1e
inside-clear-color=1a1b1e
inside-ver-color=1a1b1e
inside-wrong-color=1a1b1e

ring-color=ffffff26
ring-clear-color=8a8f98
ring-ver-color=ffffff
ring-wrong-color=bf616a

key-hl-color=ffffff
bs-hl-color=bf616a
caps-lock-key-hl-color=ebcb8b

line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000

text-color=e5e9f0
text-clear-color=8a8f98
text-ver-color=ffffff
text-wrong-color=bf616a
