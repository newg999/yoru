/* ============================================================================
   Tema "blanco" para rofi (a juego con la barra)
   El fondo es semitransparente: Niri lo desenfoca (rules.kdl → rofi)
   Para cambiar la paleta, cambia solo los colores de este primer bloque.
   ========================================================================== */

* {
    fondo:        rgba(26, 27, 30, 72%);     /* oscuro translúcido */
    fondo-alt:    rgba(255, 255, 255, 6%);   /* cajas (búsqueda, mensaje) */
    seleccion:    rgba(255, 255, 255, 90%);  /* fila elegida: blanca... */
    texto-sel:    #1a1b1e;                   /* ...con texto oscuro */
    texto:        #e5e9f0;
    texto-tenue:  #8a8f98;
    acento:       #ffffff;
    borde:        rgba(255, 255, 255, 18%);
    activo-fondo: rgba(255, 255, 255, 12%);  /* conectado / en uso */
    urgente:      #bf616a;                   /* rojo  */

    background-color: transparent;
    text-color:       @texto;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    location:         center;
    anchor:           center;
    width:            560px;
    background-color: @fondo;
    border:           1px;
    border-color:     @borde;
    border-radius:    14px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing:          12px;
    padding:          10px 14px;
    background-color: @fondo-alt;
    border-radius:    10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @acento;
}

entry {
    placeholder:       "Buscar…";
    placeholder-color: @texto-tenue;
    cursor:            text;
}

message {
    padding:          12px 14px;
    background-color: @fondo-alt;
    border-radius:    10px;
}

textbox {
    text-color: @texto;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      4px;
    fixed-height: false;
    scrollbar:    false;
    cycle:        true;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 8px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @texto;
}
element selected.normal {
    background-color: @seleccion;
    text-color:       @texto-sel;
}

/* "active" = conectado / encendido (wifi actual, auriculares conectados...) */
element normal.active,
element alternate.active {
    background-color: @activo-fondo;
    text-color:       @acento;
}
element selected.active {
    background-color: @seleccion;
    text-color:       @texto-sel;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgente;
}
element selected.urgent {
    background-color: @urgente;
    text-color:       @acento;
}

element-icon {
    size:           26px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    highlight:      bold;
}
