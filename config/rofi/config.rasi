/* ============================================================================
   rofi — lanzador de apps (Mod+Space) y base de todos los menús
   Referencia:  man rofi   ·   man rofi-theme
   Los menús (wifi, bluetooth, calendario...) están en scripts/
   ========================================================================== */

configuration {
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    terminal:            "kitty";
    font:                "JetBrainsMono Nerd Font 12";

    drun-display-format: "{name}";
    display-drun:        "";
    display-run:         "";
    display-dmenu:       "";

    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    case-sensitive:      false;

    /* Un solo clic para abrir, y el ratón resalta lo que tiene debajo */
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";

    /* Mod+Space otra vez (o Escape) cierra el menú */
    kb-cancel:           "Escape,Control+g,Control+bracketleft,Super+space";

    /* Todo lo que abre rofi pasa por lanzar.sh: si escribes algo que no
       existe y pulsas Enter, avisa en vez de dejar rofi colgado */
    /* (va por sh -c porque rofi no expande ~ ni ${HOME} aquí) */
    run-command:         "sh -c '\"$HOME\"/.config/rofi/scripts/lanzar.sh \"$0\" \"$@\"' {cmd}";
}

@theme "~/.config/rofi/tema.rasi"
