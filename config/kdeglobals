# ============================================================================
#  kdeglobals — Lo que Yoru pone en ~/.config/kdeglobals (apps Qt y Plasma)
# ----------------------------------------------------------------------------
#  Las apps Qt no miran el tema GTK: leen sus colores de ~/.config/kdeglobals.
#  Las de KDE (Okular) lo hacen solas; las demás (VirtualBox, VLC...) gracias
#  a QT_QPA_PLATFORMTHEME=kde (system/environment.d/yoru.conf). Las Flatpak
#  de KDE también lo ven. En una sesión de Plasma es su archivo de siempre.
#
#  Aquí solo van las claves que Yoru quiere en todas partes. Los colores no:
#  salen del tema (tema/aplicar.py genera el esquema «Yoru»). «yoru tema» y
#  «yoru kdeglobals» juntan las dos cosas en ~/.config/kdeglobals sin tocar
#  el resto (lo que cambies desde Plasma se queda).
# ============================================================================

[Icons]
Theme=Papirus-Dark
