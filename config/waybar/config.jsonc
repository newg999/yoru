// ============================================================================
//  Waybar — una barra por pantalla
//  Todo lo común (módulos, iconos, clics...) está en modulos.jsonc; aquí solo
//  va lo que cambia entre pantallas. Tras editar:  systemctl --user restart waybar
// ----------------------------------------------------------------------------
//  "output" elige la pantalla por nombre (míralos con: niri msg outputs).
//  "!eDP-1" = todas menos la del portátil.
// ============================================================================
[
    // Portátil: pantalla pequeña → título de la canción corto
    {
        "output": "eDP-1",
        "include": ["~/.config/waybar/modulos.jsonc"]
    },

    // Monitores externos: hay sitio de sobra → título largo
    {
        "output": "!eDP-1",
        "include": ["~/.config/waybar/modulos.jsonc"],
        "mpris":        { "title-len": 34, "artist-len": 18, "dynamic-len": 55 },
        "mpris#espejo": { "title-len": 34, "artist-len": 18, "dynamic-len": 55 }
    }
]
