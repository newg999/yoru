// ============================================================================
//  Waybar — la barra superior (estilo "islas")
//  Tras editar, recarga con:  pkill -SIGUSR2 waybar
//  Referencia de módulos:     https://github.com/Alexays/Waybar/wiki
//  Los iconos (\uXXXX) son glifos de JetBrainsMono Nerd Font.
//  Buscador de iconos:        https://www.nerdfonts.com/cheat-sheet
// ----------------------------------------------------------------------------
//  Cada "isla" es un módulo o un grupo de módulos ("group/...").
//  Para mover algo de sitio, cámbialo de lista o de grupo.
//  Clic izquierdo = menú rofi · Clic derecho = app completa
// ============================================================================
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,

    "modules-left":   ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right":  ["mpris", "group/sistema", "group/conexion", "tray"],

    // ------------------------------------------------------------- Grupos
    "group/sistema": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "battery"]
    },
    "group/conexion": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "network", "bluetooth"]
    },

    // ------------------------------------------------------------ Módulos
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active":  "",
            "default": ""
        }
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "on-click": "~/.config/rofi/scripts/calendario.py",
        "on-click-right": "gnome-calendar",
        "locale": "es_ES.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#88c0d0'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 5,
        "on-click": "kitty -e htop"
    },

    "memory": {
        "format": "  {percentage}%",
        "interval": 10,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    // Música/vídeo que suena (Spotify, YouTube en Brave, mpv...).
    // Se oculta sola si no hay nada. Clic = pausa · Clic derecho = siguiente
    "mpris": {
        "format": "  {dynamic}",
        "format-paused": "  {dynamic}",
        "dynamic-order": ["artist", "title"],
        "dynamic-len": 45,
        // Si no cabe todo, se sacrifica antes el artista que el título
        "dynamic-importance-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "tooltip-format": "{player}: {artist} · {title}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // Se oculta sola en equipos sin batería
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-full": "  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}\n{power:.1f} W · salud {health}%"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  mute",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} · {signalStrength}% · {ipaddr}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "on-click": "~/.config/rofi/scripts/wifi.py",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-connected": " {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "~/.config/rofi/scripts/bluetooth.py",
        "on-click-right": "blueman-manager"
    },

    // Bandeja del sistema: iconos de apps en segundo plano (Discord, Steam...)
    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
