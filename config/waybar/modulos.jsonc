// ============================================================================
//  Waybar — módulos y ajustes comunes a todas las barras
//  (config.jsonc crea una barra por pantalla y cada una añade sus cambios)
//  Tras editar, reinicia con:  systemctl --user restart waybar
//  (evita "pkill -SIGUSR2 waybar": con el módulo mpris puede cerrar la barra)
//  Referencia de módulos:     https://github.com/Alexays/Waybar/wiki
//  Los iconos (\uXXXX) son glifos de JetBrainsMono Nerd Font.
//  Buscador de iconos:        https://www.nerdfonts.com/cheat-sheet
// ----------------------------------------------------------------------------
//  Cada "isla" es un módulo o un grupo de módulos ("group/...").
//  Para mover algo de sitio, cámbialo de lista o de grupo.
//  Clic izquierdo = menú rofi · Clic derecho = app completa
// ============================================================================
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,

    "modules-left":   ["niri/workspaces", "niri/window"],
    // "group/espejo" es una copia invisible de la música: ocupa lo mismo a la
    // izquierda del reloj para que el reloj quede siempre en el centro exacto
    "modules-center": ["group/espejo", "clock", "group/musica"],
    "modules-right":  ["group/sistema", "group/conexion", "tray"],

    // ------------------------------------------------------------- Grupos
    // Botones de música + canción que suena (se oculta sin reproductor)
    "group/musica": {
        "orientation": "horizontal",
        "modules": ["custom/anterior", "custom/playpausa", "custom/siguiente", "mpris"]
    },
    "group/espejo": {
        "orientation": "horizontal",
        "modules": ["custom/anterior#espejo", "custom/playpausa#espejo",
                    "custom/siguiente#espejo", "mpris#espejo"]
    },
    "group/sistema": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "battery"]
    },
    "group/conexion": {
        "orientation": "horizontal",
        "modules": ["pulseaudio#icono", "group/volumen", "network", "bluetooth"]
    },
    // Clic en el porcentaje → se despliega una barrita para el volumen
    "group/volumen": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 250,
            "transition-left-to-right": true
        },
        "modules": ["pulseaudio#porcentaje", "pulseaudio/slider"]
    },

    // ------------------------------------------------------------ Módulos
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active":  "󰝥",
            "default": "󰝦"
        }
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true
    },

    // Calendario al pasar el ratón por encima:
    //   rueda = mes anterior/siguiente · clic = ver el año entero
    //   clic central = volver a hoy · clic derecho = app Calendario (eventos)
    "clock": {
        "format": "<span size='larger'>󰅐</span>  {:%H:%M}",
        "locale": "es_ES.UTF-8",
        "tooltip-format": "<span size='15pt' color='#ffffff'><b>{0:%H:%M}</b></span>   <span color='#e5e9f0'>{0:%A, %e de %B de %Y}</span>\n\n<span size='13pt'><tt>{calendar}</tt></span>\n\n<span size='9pt' color='#8a8f98'>rueda: mes · clic: año · clic central: hoy · clic dcho: eventos</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#ffffff'><b>{}</b></span>",
                "weekdays": "<span color='#9aa0aa'><b>{}</b></span>",
                "weeks":    "<span color='#5c616b'>{}</span>",
                "days":     "<span color='#e5e9f0'>{}</span>",
                "today":    "<span background='#ffffff' color='#1a1b1e'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click": "mode",
            "on-click-middle": "shift_reset",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        },
        "on-click-right": "gnome-calendar"
    },

    "cpu": {
        "format": "<span size='larger'>󰘚</span>  {usage}%",
        "interval": 5,
        "on-click": "kitty -e htop"
    },

    "memory": {
        "format": "<span size='larger'>󰍛</span>  {percentage}%",
        "interval": 10,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    // Botones de música (el script oculta los botones si no suena nada)
    "custom/anterior": {
        "exec": "~/.config/waybar/scripts/musica.sh anterior",
        "on-click": "playerctl previous",
        "tooltip-format": "Anterior"
    },
    "custom/playpausa": {
        "exec": "~/.config/waybar/scripts/musica.sh playpausa",
        "on-click": "playerctl play-pause",
        "tooltip-format": "Play / pausa"
    },
    "custom/siguiente": {
        "exec": "~/.config/waybar/scripts/musica.sh siguiente",
        "on-click": "playerctl next",
        "tooltip-format": "Siguiente"
    },

    // Música/vídeo que suena (Spotify, YouTube en Brave, mpv...).
    // Se oculta sola si no hay nada. Clic = pausa · Clic derecho = siguiente
    "mpris": {
        "format": "<span size='larger'>󰝚</span>  {dynamic}",
        "format-paused": "<span size='larger'>󰝚</span>  {dynamic}",
        "dynamic-order": ["artist", "title"],
        // Cada parte se recorta con "…" a su tamaño máximo, y dynamic-len deja
        // sitio a las dos. (Si una parte no cabe entera en dynamic-len, Waybar
        // la quita del todo: por eso antes solo salía el artista)
        "title-len": 16,
        "artist-len": 10,
        "dynamic-len": 29,
        // Si no cabe todo, se sacrifica antes el artista que el título
        "dynamic-importance-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "tooltip-format": "{player}: {artist} · {title}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // Copias invisibles (ver "group/espejo"): mismo contenido, sin clics
    "custom/anterior#espejo": {
        "cursor": 68,
        "tooltip": false,
        "exec": "~/.config/waybar/scripts/musica.sh anterior"
    },
    "custom/playpausa#espejo": {
        "cursor": 68,
        "tooltip": false,
        "exec": "~/.config/waybar/scripts/musica.sh playpausa"
    },
    "custom/siguiente#espejo": {
        "cursor": 68,
        "tooltip": false,
        "exec": "~/.config/waybar/scripts/musica.sh siguiente"
    },
    // Acciones vacías a propósito: sin ellas, mpris hace play/pausa/siguiente
    // por su cuenta y la copia invisible funcionaría como un botón fantasma
    // "cursor": 68 = la flecha normal. Sin esto, Waybar pone la mano de
    // "se puede pulsar" en todo módulo con acciones de clic (aunque estén vacías)
    "mpris#espejo": {
        "tooltip": false,
        "cursor": 68,
        "on-click": "",
        "on-click-middle": "",
        "on-click-right": "",
        "on-click-backward": "",
        "on-click-forward": "",
        "format": "<span size='larger'>󰝚</span>  {dynamic}",
        "format-paused": "<span size='larger'>󰝚</span>  {dynamic}",
        "dynamic-order": ["artist", "title"],
        // Cada parte se recorta con "…" a su tamaño máximo, y dynamic-len deja
        // sitio a las dos. (Si una parte no cabe entera en dynamic-len, Waybar
        // la quita del todo: por eso antes solo salía el artista)
        "title-len": 16,
        "artist-len": 10,
        "dynamic-len": 29,
        // Si no cabe todo, se sacrifica antes el artista que el título
        "dynamic-importance-order": ["title", "artist"],
        "dynamic-separator": " · "
    },

    // Se oculta sola en equipos sin batería
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "<span size='larger'>{icon}</span>  {capacity}%",
        "format-charging": "<span size='larger'>󰂄</span>  {capacity}%",
        "format-plugged": "<span size='larger'>󰚥</span>  {capacity}%",
        "format-full": "<span size='larger'>󰁹</span>  {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power:.1f} W · salud {health}%"
    },

    // Audio en dos piezas:
    //   icono      → clic = elegir salida (altavoces, auriculares, monitor...) y micro
    //   porcentaje → clic = barrita de volumen (ver "group/volumen")
    // Rueda = volumen en los dos · en el icono: clic central = silenciar,
    // clic derecho = mezclador
    "pulseaudio#icono": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "hdmi": "󰍹",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "~/.config/rofi/scripts/audio.py",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{desc}\nclic: elegir salida y micrófono"
    },
    // Sin acciones de clic a propósito: si tuviera alguna, Waybar se quedaría
    // el clic y no llegaría al grupo que despliega la barrita
    "pulseaudio#porcentaje": {
        "format": "{volume}%",
        "format-muted": "mute",
        "scroll-step": 5,
        "tooltip-format": "{volume}% · clic: barra de volumen"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} · {signalStrength}% · {ipaddr}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "on-click": "~/.config/rofi/scripts/wifi.py",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "~/.config/rofi/scripts/bluetooth.py"
    },

    // Bandeja del sistema: iconos de apps en segundo plano (Discord, Steam...)
    // "cursor": true = la mano de "se puede pulsar" al pasar por encima
    "tray": {
        "cursor": true,
        "icon-size": 20,
        "spacing": 10
    }
}
