// ============================================================================
//  rules.kdl — Reglas para ventanas y capas
// ----------------------------------------------------------------------------
//  Para saber el app-id de una ventana:  niri msg windows
//  Para ver las capas (barra, fondo...):  niri msg layers
//  Las reglas se aplican en orden: si dos chocan, gana la de más abajo.
// ============================================================================

// --- Todas las ventanas ------------------------------------------------------
window-rule {
    // Esquinas redondeadas
    geometry-corner-radius 10
    clip-to-geometry true

    // El anillo de foco se dibuja alrededor, no detrás (si no, se
    // transparenta a través de las ventanas semitransparentes)
    draw-border-with-background false

    // Algunas apps (Brave, Chrome, VS Code...) recuerdan que las cerraste
    // maximizadas y piden abrirse "a pantalla entera", sin márgenes.
    // Esto lo impide: todas se abren como una columna normal.
    // Para maximizar a mano una ventana: Mod+M (o Mod+F dejando márgenes).
    open-maximized-to-edges false
}

// --- Transparencia y desenfoque ----------------------------------------------
// Las ventanas que no tienen el foco se vuelven un poco transparentes.
// Mod+Alt+O activa/desactiva la transparencia de la ventana actual.
window-rule {
    match is-active=false
    opacity 0.92
}

// Navegador, terminal y VirtualBox (el administrador y las máquinas): se
// abren a todo el ancho (el resto, a la mitad). Mod+R los va estrechando
window-rule {
    match app-id="^kitty$"
    match app-id=r#"(?i)(firefox|brave|chrom)"#
    match app-id="^VirtualBox (Manager|Machine)$"
    default-column-width { proportion 1.0; }
}

// Máquinas virtuales de VirtualBox: se abren maximizadas hasta los bordes
// (toda la pantalla bajo la barra) y siempre opacas. La máquina adapta su
// resolución al tamaño de la ventana: si la ventana cambiaba de tamaño, la
// pantalla de la máquina se reajustaba sola y quedaba rara (p. ej. 1262x1340).
// Mod+M quita o vuelve a poner el maximizado.
window-rule {
    match app-id="^VirtualBox Machine$"
    open-maximized-to-edges true
    opacity 1.0
}

// Terminal: transparente y con el fondo desenfocado
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}

// Navegadores y reproductores siempre opacos (vídeos, fotos...)
window-rule {
    match app-id=r#"(?i)(firefox|brave|chrom|mpv|vlc|celluloid|loupe)"#
    opacity 1.0
}

// --- Ventanas flotantes ------------------------------------------------------
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match title="^Picture in picture$"
    match app-id="^org.pulseaudio.pavucontrol$"
    match app-id="^blueman-manager$"
    match app-id="^nm-connection-editor$"
    match title="^(Abrir|Guardar|Open|Save)( archivo| File)?"
    open-floating true
}

// Apps pequeñas (calculadora, mapa de caracteres, Elisa...): flotantes, con su
// tamaño normal y centradas, en vez de ocupar media pantalla. Se mueven
// arrastrándolas con Mod pulsado (o por su barra de título, si tienen).
// Tamaño: Mod + clic derecho y arrastrar (vale aunque la app no tenga marco,
// como las de KDE: Elisa...), o Mod +/- (ancho) y Mod+Shift +/- (alto).
// ¿Quieres otra? Mira su app-id con «niri msg windows» y añade un match.
// Cualquier ventana se puede hacer flotante (o volver a columna) con Mod+V.
window-rule {
    match app-id="^org.gnome.Calculator$"
    match app-id="^org.kde.kcalc$"
    match app-id="^org.kde.kcharselect$"
    match app-id="^org.gnome.Characters$"
    match app-id="^org.kde.elisa$"
    open-floating true
    opacity 1.0
}

// Elisa (música) recuerda el tamaño con el que la cerraste: se le da uno en
// proporción a la pantalla, para que quepa igual en 1440p que en 1080p
window-rule {
    match app-id="^org.kde.elisa$"
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.65; }
}

// Ventanas que piden contraseña (administrador y llavero): flotantes y
// centradas, como un diálogo, no como una columna de media pantalla
window-rule {
    match app-id=r#"(?i)(polkit|policykit|gcr-prompter)"#
    open-floating true
    opacity 1.0
}

// Terminal de actualizaciones de la tienda (Mod+Alt+S → Actualizar todo)
window-rule {
    match app-id="^tienda$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

// Swappy (editor de capturas): flotante, no ocupa una columna
window-rule {
    match app-id="^swappy$"
    open-floating true
}

// Calendario de GNOME flotante y centrado
window-rule {
    match app-id="^org.gnome.Calendar$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 650; }
}

// VirtualBox abre una ventana vacía un instante al arrancar (antes que el
// administrador o la máquina). Invisible y flotante: así no parpadea ni
// ocupa una columna
window-rule {
    match app-id="^VirtualBox$" title="^VirtualBox$"
    open-floating true
    open-focused false
    opacity 0.0
}

// --- Privacidad --------------------------------------------------------------
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

// --- Capas (barra, lanzador, notificaciones, fondo) --------------------------

// Fondo de pantalla visible dentro del overview (Mod+O)
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// Las notificaciones no salen en grabaciones de pantalla
layer-rule {
    match namespace="^yoru-avisos$"
    block-out-from "screencast"
}
