// ============================================================================
//  colors.kdl — El "tema" de Niri
// ----------------------------------------------------------------------------
//  Tema "blanco": blanco sobre oscuro neutro, translúcido. El color se
//  reserva para los avisos (rojo = urgente/error, amarillo = atención).
//  Si cambias de paleta, cambia también:
//    waybar/style.css · rofi/tema.rasi · mako/config
//    kitty/kitty.conf · swaylock/config · flameshot/flameshot.ini
// ----------------------------------------------------------------------------
//  oscuro #1a1b1e   oscuro-2 #26272b   gris #8a8f98
//  texto  #e5e9f0   blanco   #ffffff
//  rojo   #bf616a   amarillo #ebcb8b
// ============================================================================

layout {
    focus-ring {
        // Blanco translúcido en la ventana activa (los dos últimos dígitos
        // son la opacidad: ff = sólido, 80 = mitad)
        active-color "#ffffffcc"
        inactive-color "#ffffff26"
    }

    border {
        active-color "#ffffffcc"
        inactive-color "#ffffff26"
        urgent-color "#bf616a"
    }

    shadow {
        color "#00000099"
    }
}

overview {
    backdrop-color "#111214"
}
