// ============================================================================
//  colors.kdl — El "tema" de Niri
// ----------------------------------------------------------------------------
//  Tema "blanco": blanco sobre oscuro neutro, translúcido. El color se
//  reserva para los avisos (rojo = urgente/error, amarillo = atención).
//  Estos son solo los colores de reserva. Los que se usan de verdad los
//  genera «yoru tema» a partir de tema/blanco.json (o del fondo de pantalla)
//  y se incluyen después, en config.kdl. Para cambiar la paleta de todo el
//  escritorio, edita tema/blanco.json y ejecuta: yoru tema blanco
//  (la pantalla de inicio de sesión y el bloqueo de reserva, swaylock, no
//  siguen al tema: sus colores están en system/greetd/gtkgreet.css y
//  swaylock/config)
// ----------------------------------------------------------------------------
//  oscuro #1a1b1e   oscuro-2 #26272b   gris #8a8f98
//  texto  #e5e9f0   blanco   #ffffff
//  rojo   #bf616a   amarillo #ebcb8b
// ============================================================================

layout {
    focus-ring {
        // Blanco translúcido en la ventana activa (los dos últimos dígitos
        // son la opacidad: ff = sólido, 80 = mitad)
        active-color "#ffffffcc"
        inactive-color "#ffffff26"
    }

    border {
        active-color "#ffffffcc"
        inactive-color "#ffffff26"
        urgent-color "#bf616a"
    }

    shadow {
        color "#00000099"
    }
}

overview {
    backdrop-color "#111214"
}
