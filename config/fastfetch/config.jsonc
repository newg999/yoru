// fastfetch — info del sistema al abrir la terminal (lo lanza config/zsh/zshrc)
// El logo es yoru.txt: 夜 (yoru, «noche») en grande, sacado de Noto Serif CJK
// con bloques de cuartos de celda, una luna y «よる · yoru». $1 es el kanji,
// la luna y よる (color de acento) y $2 las estrellas y «yoru» (gris).
// zshrc le pasa los colores del tema de «yoru tema» (ver tema/aplicar.py);
// sin tema, salen los de aquí.
{
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/yoru.txt",
        "color": {
            "1": "blue",
            "2": "bright_black"
        },
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "blue"
        },
        // Una línea que no cabe se corta, no salta a la siguiente (se
        // montaba encima del logo)
        "disableLinewrap": true
    },
    // Textos cortos: así caben al lado del logo en una terminal estrecha
    "modules": [
        "title",
        "separator",
        { "type": "os", "format": "{name} {version-id}" },
        "host",
        { "type": "kernel", "format": "{release}" },
        "uptime",
        { "type": "packages", "format": "{all} ({flatpak-all} flatpak)" },
        "shell",
        { "type": "display", "key": "Display", "format": "{width}x{height} @ {refresh-rate} Hz" },
        { "type": "wm", "key": "WM", "format": "{pretty-name} {version}" },
        "theme",
        "icons",
        "terminal",
        { "type": "cpu", "format": "{name} ({cores-logical})" },
        { "type": "gpu", "format": "{name}" },
        "memory",
        { "type": "disk", "key": "Disk", "format": "{size-used} / {size-total} ({size-percentage})" },
        { "type": "battery", "key": "Battery", "format": "{capacity} · {status}" }
    ]
}
