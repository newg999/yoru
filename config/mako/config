# ============================================================================
#  mako — notificaciones
#  Tras editar:  makoctl reload        Probar:  notify-send "Hola" "Funciona"
#  Referencia:   man 5 mako
# ============================================================================

font=JetBrainsMono Nerd Font 11
width=360
height=150
margin=12
padding=14
border-size=2
border-radius=12
icons=1
max-icon-size=48
default-timeout=5000
anchor=top-right

background-color=#2e3440f0
text-color=#d8dee9
border-color=#88c0d0
progress-color=over #434c5e

[urgency=low]
border-color=#4c566a

[urgency=critical]
border-color=#bf616a
default-timeout=0
