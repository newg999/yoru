# ============================================================================
#  mako — notificaciones
#  Tras editar:  makoctl reload        Probar:  notify-send "Hola" "Funciona"
#  Referencia:   man 5 mako
# ============================================================================

font=JetBrainsMono Nerd Font 11
width=360
height=150
margin=12
padding=14
border-size=1
border-radius=12
icons=1
max-icon-size=48
default-timeout=5000
anchor=top-right

background-color=#1a1b1ee6
text-color=#e5e9f0
border-color=#ffffff40
progress-color=over #ffffff26

[urgency=low]
border-color=#ffffff1a
text-color=#8a8f98

[urgency=critical]
border-color=#bf616a
default-timeout=0
