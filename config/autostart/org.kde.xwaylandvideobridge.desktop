# Anula /etc/xdg/autostart/org.kde.xwaylandvideobridge.desktop: no arrancar
# la «Pasarela de vídeo Xwayland» de KDE. Al iniciar pedía permiso para
# grabar la pantalla (una ventana negra). En niri no hace falta: las apps
# comparten pantalla con el portal (xdg-desktop-portal-gnome).
[Desktop Entry]
Type=Application
Name=Xwayland Video Bridge
Hidden=true
