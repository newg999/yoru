# Meteosat: mapa del tiempo de Canarias (viento animado, rachas, lluvia, nubes
# del satélite y temperatura). Es una ventana de Yoru (paneles/Meteosat.qml, con
# scripts/meteosat.py detrás): esto solo se la pide a la barra. niri la abre
# a todo el ancho (config/niri/rules.kdl). install.sh lo enlaza para que salga
# en el lanzador.
[Desktop Entry]
Type=Application
Name=Meteosat
Comment=Mapa del tiempo: viento animado, rachas, lluvia, nubes (satélite) y temperatura
Keywords=meteosat;tiempo;clima;meteo;viento;rachas;lluvia;nubes;satélite;radar;temperatura;weather;
Icon=weather-few-clouds
Exec=qs -c yoru ipc call meteosat alternar
Terminal=false
Categories=Utility;
