# Música de Yoru: la ventana de la música (Quickshell, paneles/VentanaMusica.qml)
# y la app predeterminada para el audio (install.sh → apps_predeterminadas)
[Desktop Entry]
Type=Application
Name=Música
GenericName=Reproductor de música
Comment=Tu música: discos, artistas y canciones
Icon=multimedia-audio-player
Exec=yoru musica %F
Terminal=false
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/wav;audio/x-wav;audio/x-aiff;audio/x-ape;audio/x-wavpack;audio/x-mpegurl;
Categories=AudioVideo;Audio;Player;
Keywords=música;musica;canciones;discos;mp3;flac;reproductor;
StartupNotify=false
