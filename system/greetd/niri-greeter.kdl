// ============================================================================
//  niri-greeter.kdl — La pantalla de inicio de Yoru
// ----------------------------------------------------------------------------
//  greetd arranca un niri mínimo con esta config, que muestra la pantalla de
//  inicio de Yoru (yoru/shell.qml, en Quickshell). Al entrar, termina y este
//  niri se cierra para dar paso a tu sesión.
//  install.sh lo copia a /etc/greetd/ (es del sistema, no de tu usuario).
// ============================================================================

input {
    keyboard {
        xkb { }     // la distribución del sistema (la de la instalación)
        numlock
    }
    touchpad { tap; }
}

// El cursor de tu sesión (install.sh lo copia a /usr/share/icons, porque el
// usuario greetd no ve tu ~/.local)
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// Nada de chuleta de atajos ni barras de título aquí
hotkey-overlay { skip-at-startup; }
prefer-no-csd

layout {
    background-color "#1a1b1e"
}

// Fondo: tu fondo desenfocado (install.sh lo deja aquí y wallpaper.sh lo
// actualiza al cambiar de fondo)
spawn-at-startup "swaybg" "-m" "fill" "-i" "/usr/share/backgrounds/yoru/inicio"

// La pantalla de inicio de Yoru (Quickshell, /etc/greetd/yoru/shell.qml): la
// misma que la de bloqueo. Si no arranca o falla, gtkgreet de reserva
// (GTK_THEME: campos y botones oscuros aunque el usuario greetd no tenga
// ajustes propios). Al entrar, este niri se cierra para dar paso a tu sesión.
spawn-sh-at-startup "qs -p /etc/greetd/yoru || GTK_THEME=Adwaita:dark gtkgreet --layer-shell --style /etc/greetd/gtkgreet.css --command niri-session; niri msg action quit --skip-confirmation"

// Tus ajustes de este equipo (monitores, velocidad del ratón...): install.sh
// copia aquí tu ~/.config/niri/local.kdl (y raton.kdl, de Ajustes › Ratón)
include optional=true "local.kdl"
include optional=true "raton.kdl"

binds {
    // Apagar y reiniciar sin entrar (el botón de encendido también apaga)
    Ctrl+Alt+Delete { spawn "systemctl" "reboot"; }
    Ctrl+Alt+End    { spawn "systemctl" "poweroff"; }
}
