# -------------------------------------------------------------------- ventana
def tamano_portada():
    """Carátula de 300 px, menos en pantallas bajas (el portátil tiene 768),
    para que quede sitio para la lista."""
    alto = 1080
    monitores = Gdk.Display.get_default().get_monitors()
    if monitores.get_n_items():
        alto = min(monitores.get_item(i).get_geometry().height
                   for i in range(monitores.get_n_items()))
    return max(180, min(300, alto - 540))


def textura_cuadrada(datos, lado):
    """La carátula recortada al centro en cuadrado y a su tamaño."""
    try:
        carga = GdkPixbuf.PixbufLoader()
        carga.write(datos)
        carga.close()
        pb = carga.get_pixbuf()
    except GLib.Error:
        return None
    if pb is None:
        return None
    n = min(pb.get_width(), pb.get_height())
    pb = pb.new_subpixbuf((pb.get_width() - n) // 2, (pb.get_height() - n) // 2, n, n)
    pb = pb.scale_simple(lado, lado, GdkPixbuf.InterpType.BILINEAR)
    return Gdk.Texture.new_for_pixbuf(pb)


class IconoPlay(Gtk.DrawingArea):
    """▶ o ❚❚ centrados al píxel en el botón redondo. El triángulo se corre
    un poco a la derecha (centrado óptico: su peso está en el lado ancho)."""

    def __init__(self, ventana):
        super().__init__(content_width=24, content_height=24,
                         halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.v = ventana
        self.sonando = False
        self.set_draw_func(self._pintar)

    def poner(self, sonando):
        if sonando != self.sonando:
            self.sonando = sonando
            self.queue_draw()

    def _pintar(self, _a, cr, ancho, alto):
        cr.set_source_rgb(*rgb(self.v.colores["fondo"]))
        cx, cy = ancho / 2, alto / 2
        if self.sonando:
            for x in (cx - 6, cx + 2):                     # dos barras de 4×16
                redondo(cr, x, cy - 8, 4, 16, 1.2)
                cr.fill()
        else:
            h, w = 16, 14
            x0 = cx - w / 2 + 1.5                          # centrado óptico
            cr.move_to(x0, cy - h / 2)
            cr.line_to(x0 + w, cy)
            cr.line_to(x0, cy + h / 2)
            cr.close_path()
            cr.set_line_join(1)                            # esquinas redondeadas
            cr.set_line_width(2)
            cr.fill_preserve()
            cr.stroke()


# --------------------------------------------------------- modo visualización
# Como las visualizaciones del Reproductor de Windows Media de XP, pero
# propias: cada fotograma es el anterior deformado (zoom, giro, remolino),
# difuminado y apagado, más lo que dibuja la escena con el audio de cava.
# Se calcula pequeño con numpy (~1,5 ms) y la GPU lo escala suavizado.

class Escena:
    nombre = ""
    zoom = 1.0      # >1: lo de antes se acerca (sale hacia fuera); <1: se va al centro
    giro = 0.0      # radianes por fotograma
    remolino = 0.0  # giro extra según la distancia al centro
    apagado = 0.94  # cuánto queda del fotograma anterior
    color = "acento"  # color del tema para lo brillante

    def __init__(self):
        self.t = 0.0

    def emitir(self, motor, a):
        pass


class MareaNocturna(Escena):
    """Una flor de puntos que respira con el bajo, como la espiral de XP."""
    nombre = "marea nocturna"
    zoom, giro, remolino, apagado = 1.012, 0.004, 0.012, 0.93

    def emitir(self, m, a):
        n = 900
        fi = np.linspace(0, 2 * math.pi, n, endpoint=False)
        petalos = 8
        r = 0.22 + 0.42 * (0.35 + 0.65 * np.abs(np.cos(petalos / 2 * fi))) * (0.55 + a["bajo"])
        ang = fi + self.t * 0.25
        m.puntos(r * np.cos(ang), r * np.sin(ang), 0.25 + 0.6 * a["agudo"])


class Luciernagas(Escena):
    """Puntitos que vagan y se encienden cada uno con su banda del espectro."""
    nombre = "luciérnagas"
    color = "amarillo"
    zoom, giro, remolino, apagado = 0.995, 0.0, 0.0, 0.88

    def __init__(self):
        super().__init__()
        rng = np.random.default_rng(7)
        self.p = rng.uniform(-0.9, 0.9, (160, 2))
        self.fase = rng.uniform(0, 2 * math.pi, (160, 2))

    def emitir(self, m, a):
        vel = 0.003 + 0.012 * a["medio"]
        self.p += vel * np.stack([np.sin(self.t * 0.7 + self.fase[:, 0]),
                                  np.cos(self.t * 0.5 + self.fase[:, 1])], 1)
        self.p = (self.p + 1) % 2 - 1
        niveles = a["niveles"]
        brillo = 0.3 + 1.2 * niveles[np.arange(len(self.p)) % len(niveles)]
        m.puntos(self.p[:, 0], self.p[:, 1], brillo, gordo=True)


class TunelDeNeon(Escena):
    """Un cuadrado que gira en el borde y se cuela hacia el centro."""
    nombre = "túnel de neón"
    color = "rojo"
    zoom, giro, remolino, apagado = 0.965, 0.010, 0.0, 0.88

    def emitir(self, m, a):
        n = 480
        s = np.linspace(-1, 1, n // 4)
        lado = 0.62 + 0.2 * a["bajo"]
        xs = np.concatenate([s, np.ones_like(s), -s, -np.ones_like(s)]) * lado
        ys = np.concatenate([np.ones_like(s), s, -np.ones_like(s), -s]) * lado
        g = self.t * 0.6
        x = xs * math.cos(g) - ys * math.sin(g)
        y = xs * math.sin(g) + ys * math.cos(g)
        # solo con los golpes del bajo: así salen aros separados, no una mancha
        m.puntos(x, y, 0.18 + 2.2 * a["bajo"] ** 2)


class Corona(Escena):
    """El espectro en círculo: 40 rayos que dejan estela en espiral."""
    nombre = "corona"
    zoom, giro, remolino, apagado = 1.018, 0.008, 0.0, 0.91

    def emitir(self, m, a):
        niveles = a["niveles"]
        k = len(niveles)
        ang = np.repeat(np.linspace(0, 2 * math.pi, k, endpoint=False) + self.t * 0.2, 14)
        largo = np.repeat(niveles, 14)
        paso = np.tile(np.linspace(0, 1, 14), k)
        r = 0.18 + paso * (0.05 + 0.55 * largo)
        m.puntos(r * np.cos(ang), r * np.sin(ang), 0.2 + 0.8 * largo)


class Remolino(Escena):
    """Dos brazos de humo que giran; el remolino los enrosca."""
    nombre = "remolino de humo"
    color = "texto"
    zoom, giro, remolino, apagado = 1.004, 0.0, 0.05, 0.955

    def emitir(self, m, a):
        n = 300
        u = np.linspace(0.05, 0.95, n)
        for brazo in (0, math.pi):
            ang = u * 5 + self.t * (0.8 + a["medio"]) + brazo
            r = u * (0.55 + 0.5 * a["bajo"])
            m.puntos(r * np.cos(ang), r * np.sin(ang), 0.15 + 0.5 * a["agudo"] + 0.25 * (1 - u))


ESCENAS = [MareaNocturna, Luciernagas, TunelDeNeon, Corona, Remolino]


class Motor:
    def __init__(self, ancho=320, alto=320):
        self.escena = ESCENAS[0]()
        self.tamano(ancho, alto)
        self.paleta(np.array([[26, 27, 38], [122, 162, 247], [235, 240, 255]]))

    def tamano(self, ancho, alto, centro=(0.5, 0.5), escala=1.0):
        """centro: dónde nace todo, en fracción de ancho y alto (de fondo, en
        la carátula, para que el resplandor la rodee como un halo)."""
        self.w, self.h = int(ancho), int(alto)
        self.cx, self.cy = centro[0] * self.w, centro[1] * self.h
        self.esc = min(self.w, self.h) / 2 * escala
        self.buf = np.zeros((self.h, self.w), np.float32)
        self._mapa = None
        # viñeteado: solo se apaga suave junto a los bordes (si no, el
        # resplandor chocaba con ellos y se cortaba en seco)
        yy, xx = np.mgrid[0:self.h, 0:self.w].astype(np.float32)
        bx = np.clip(np.minimum(xx, self.w - 1 - xx) / (0.18 * self.w), 0, 1)
        by = np.clip(np.minimum(yy, self.h - 1 - yy) / (0.12 * self.h), 0, 1)
        self._vineta = (bx * by) ** 1.2

    def paleta(self, tres):
        """fondo → acento → casi blanco, 256 pasos."""
        x = np.linspace(0, 1, 256)[:, None]
        f, ac, bl = (np.asarray(c, np.float32) for c in tres)
        x = x ** 0.7   # levanta los tonos medios: el resplandor se ve más
        lut = np.where(x < 0.55, f + (ac - f) * (x / 0.55), ac + (bl - ac) * ((x - 0.55) / 0.45))
        lut = lut.clip(0, 255).astype(np.uint32)
        # empaquetada en un uint32 por color (R8G8B8A8): np.take es ~3× más
        # rápido que indexar una tabla de 3 columnas
        self.lut = lut[:, 0] | (lut[:, 1] << 8) | (lut[:, 2] << 16) | np.uint32(0xFF000000)

    def poner(self, clase):
        self.escena = clase()
        self._mapa = None

    def _deformacion(self):
        e = self.escena
        esc = self.esc
        yy, xx = np.mgrid[0:self.h, 0:self.w].astype(np.float32)
        u = (xx - self.cx + 0.5) / esc
        v = (yy - self.cy + 0.5) / esc
        r = np.sqrt(u * u + v * v)
        g = -(e.giro + e.remolino * (1 - np.minimum(r, 1.4)))
        su = (u * np.cos(g) - v * np.sin(g)) / e.zoom
        sv = (u * np.sin(g) + v * np.cos(g)) / e.zoom
        fx = su * esc + self.cx - 0.5
        fy = sv * esc + self.cy - 0.5
        dentro = (fx >= 0) & (fx <= self.w - 1) & (fy >= 0) & (fy <= self.h - 1)
        # bilineal: cada píxel mezcla sus 4 vecinos del fotograma anterior.
        # Con «el más cercano» salían escalones que, ampliados, se veían pixelados
        x0 = np.clip(np.floor(fx), 0, self.w - 2).astype(np.int32)
        y0 = np.clip(np.floor(fy), 0, self.h - 2).astype(np.int32)
        ax = np.clip(fx - x0, 0, 1).astype(np.float32).ravel()
        ay = np.clip(fy - y0, 0, 1).astype(np.float32).ravel()
        d = dentro.astype(np.float32).ravel()      # lo que entra de fuera, negro
        self._mapa = (y0 * self.w + x0).ravel()
        self._pesos = ((1 - ax) * (1 - ay) * d, ax * (1 - ay) * d, (1 - ax) * ay * d, ax * ay * d)

    def puntos(self, x, y, brillo, gordo=False):
        # cada punto se reparte entre los 4 píxeles que pisa (suavizado)
        esc = self.esc
        fx = np.asarray(x, np.float32) * esc + self.cx
        fy = np.asarray(y, np.float32) * esc + self.cy
        x0 = np.floor(fx).astype(np.int32)
        y0 = np.floor(fy).astype(np.int32)
        ax, ay = fx - x0, fy - y0
        b = np.broadcast_to(np.asarray(brillo, np.float32) * (2.6 if gordo else 1.9), fx.shape)
        plano = self.buf.ravel()
        for dx, dy, peso in ((0, 0, (1 - ax) * (1 - ay)), (1, 0, ax * (1 - ay)),
                             (0, 1, (1 - ax) * ay), (1, 1, ax * ay)):
            qx, qy = x0 + dx, y0 + dy
            ok = (qx >= 0) & (qx < self.w) & (qy >= 0) & (qy < self.h)
            plano += np.bincount((qy[ok] * self.w + qx[ok]), weights=(b * peso)[ok],
                                 minlength=self.w * self.h).astype(np.float32)

    def paso(self, niveles, dt=1 / 40, emitir=True):
        e = self.escena
        if self._mapa is None:
            self._deformacion()
        n = np.asarray(niveles, np.float32)
        a = {"niveles": n, "bajo": float(n[:6].mean()), "medio": float(n[6:20].mean()),
             "agudo": float(n[20:].mean())}
        f, i, w = self.buf.ravel(), self._mapa, self.w
        p00, p10, p01, p11 = self._pesos
        b = (np.take(f, i) * p00 + np.take(f, i + 1) * p10 + np.take(f, i + w) * p01
             + np.take(f, i + w + 1) * p11).reshape(self.h, w)
        # difuminado barato (cruz de 5) para el resplandor
        b = (b * 2 + np.roll(b, 1, 0) + np.roll(b, -1, 0) + np.roll(b, 1, 1) + np.roll(b, -1, 1)) / 6
        if emitir:
            self.buf = b * e.apagado
            e.t += dt
            e.emitir(self, a)
        else:
            # disipándose (en pausa): sigue girando, no dibuja nada nuevo y
            # se apaga más deprisa
            self.buf = b * min(e.apagado, 0.9)
        np.clip(self.buf, 0, 1.2, out=self.buf)

    def imagen(self):
        """RGBA (alto, ancho) en uint32 empaquetado."""
        i = (np.minimum(self.buf * self._vineta, 1.0) * 255).astype(np.uint8)
        return np.take(self.lut, i)


class Lienzo(GObject.Object, Gdk.Paintable):
    """Donde se pinta la visualización. Cambiar de imagen solo pide
    redibujar (invalidate_contents): con set_paintable en cada fotograma GTK
    recolocaba toda la ventana. Sin tamaño propio: llena lo que le den."""

    def __init__(self):
        super().__init__()
        self.tex = None

    def poner(self, tex):
        self.tex = tex
        self.invalidate_contents()

    def do_snapshot(self, snapshot, ancho, alto):
        if self.tex is None:
            return
        rect = Graphene.Rect().init(0, 0, ancho, alto)
        # Al ampliar mucho (ventana grande, pantalla completa) los píxeles se
        # notaban como bloques: un desenfoque en la GPU, proporcional a lo que
        # se amplía, los funde sin gastar CPU (y da el resplandor de XP)
        factor = ancho / max(1, self.tex.get_width())
        if factor > 1.4:
            snapshot.push_blur(factor * 0.8)
        snapshot.append_scaled_texture(self.tex, Gsk.ScalingFilter.LINEAR, rect)
        if factor > 1.4:
            snapshot.pop()

    def do_get_flags(self):
        return Gdk.PaintableFlags.SIZE

    def do_get_intrinsic_width(self):
        return 0

    def do_get_intrinsic_height(self):
        return 0


class Pelicula:
    """El modo visualización: en la carátula o a pantalla completa («cine»)."""
    PASO = 1 / 30   # lo que da cava; más solo gasta

    def __init__(self, v):
        self.v = v
        self.motor = Motor(v.lado, v.lado)
        # en la carátula, Gtk.Image con pixel_size (Gtk.Picture pedía el tamaño
        # de la imagen y agrandaba la carátula, como pasó con la foto)
        self.lienzo_portada = Lienzo()
        self.lienzo_cine = Lienzo()
        # de fondo de toda la ventana (detrás de los mandos y la lista)
        self.portada = Gtk.Picture(paintable=self.lienzo_portada, content_fit=Gtk.ContentFit.FILL,
                                   can_shrink=True, can_target=False, visible=False)
        self.cine = Gtk.Picture(paintable=self.lienzo_cine, content_fit=Gtk.ContentFit.FILL,
                                can_shrink=True, hexpand=True, vexpand=True)
        self.tic = None
        self.tic_en = None
        self.disipando = False
        self.ultimo = None
        self.acum = 0.0
        self.desde = 0.0
        eleccion = leer_json(PREFERENCIAS).get("escena", "aleatoria")
        self.aleatoria = eleccion == "aleatoria"
        clase = next((e for e in ESCENAS if e.nombre == eleccion), None)
        self.poner(clase or random.choice(ESCENAS))

    def poner(self, clase):
        self.motor.poner(clase)
        if hasattr(self.v, "colores"):
            self.colorear()
        self.desde = time.monotonic()
        self.v._pintar_pie()

    def colorear(self):
        c = self.v.colores
        acento = [int(x * 255) for x in rgb(c.get(self.motor.escena.color, c["acento"]))]
        fondo = [int(x * 255) for x in rgb(c["fondo"])]
        brillo = [min(255, x + 70) for x in acento]
        self.motor.paleta(np.array([fondo, acento, brillo]))

    def lienzo(self):
        return self.cine if self.v.modo == "cine" else self.portada

    def tamano(self, ancho, alto, centro=(0.5, 0.5), escala=1.0):
        self.motor.tamano(ancho, alto, centro, escala)

    def animar(self, disipar=False):
        self.disipando = disipar
        destino = self.lienzo()
        if self.tic is not None and self.tic_en is not destino:
            self.quieto()
        if self.tic is None:
            self.ultimo = None
            self.tic_en = destino
            self.tic = destino.add_tick_callback(self._paso)

    def quieto(self):
        """Se congela en el último fotograma (en pausa no gasta nada)."""
        if self.tic is not None:
            self.tic_en.remove_tick_callback(self.tic)
            self.tic = None

    def _paso(self, _w, reloj):
        t = reloj.get_frame_time() / 1e6
        if self.ultimo is None:
            self.ultimo = t
        self.acum += min(t - self.ultimo, 0.1)
        self.ultimo = t
        hecho = False
        while self.acum >= self.PASO:
            self.motor.paso(self.v.visu.objetivo, self.PASO, emitir=not self.disipando)
            self.acum -= self.PASO
            hecho = True
        if self.disipando and float(self.motor.buf.max()) < 0.01:
            self.motor.buf[:] = 0
            self.mostrar()
            self.tic = None          # ya a oscuras: deja de gastar
            return GLib.SOURCE_REMOVE
        if self.aleatoria and time.monotonic() - self.desde > 25:
            otras = [e for e in ESCENAS if not isinstance(self.motor.escena, e)]
            self.poner(random.choice(otras))
        if hecho:
            self.mostrar()
        return GLib.SOURCE_CONTINUE

    def mostrar(self):
        img = self.motor.imagen()
        h, w = img.shape
        tex = Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8A8,
                                    GLib.Bytes.new(img.tobytes()), w * 4)
        (self.lienzo_cine if self.v.modo == "cine" else self.lienzo_portada).poner(tex)


class Raiz(Gtk.Box):
    """Columna sola (estrecha) o columna + lista a la derecha (ancha)."""

    def __init__(self, ventana):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.v = ventana
        self.ancha = False

        # GTK4 no avisa (ni notify::default-width ni size_allocate desde Python)
        # cuando niri cambia el tamaño: una capa invisible encima de todo, con
        # la señal «resize» de DrawingArea, sí se entera
        self.sensor = Gtk.DrawingArea(can_target=False, hexpand=True, vexpand=True)
        self.sensor.connect("resize", self._al_cambiar_ancho)

    def _al_cambiar_ancho(self, _area, ancho, alto):
        if self.v.modo == "portada":
            # después de colocar (la carátula cambia de sitio con la vista)
            GLib.timeout_add(60, lambda: self.v._tamano_fondo(ancho, alto) and False)
        ancha = ancho >= ANCHO_DOBLE
        if ancha != self.ancha:
            self.ancha = ancha
            GLib.idle_add(self._colocar)

    def _colocar(self):
        v = self.v
        if self.ancha:
            self.set_orientation(Gtk.Orientation.HORIZONTAL)
            self.set_spacing(40)
            v.columna.set_valign(Gtk.Align.START)   # carátula y lista empiezan a la vez
            v.zona_lista.set_halign(Gtk.Align.FILL)
            v.zona_lista.set_hexpand(True)
            v.cabecera.set_margin_top(0)
        else:
            self.set_orientation(Gtk.Orientation.VERTICAL)
            self.set_spacing(0)
            v.columna.set_valign(Gtk.Align.START)
            v.zona_lista.set_halign(Gtk.Align.CENTER)
            v.zona_lista.set_hexpand(False)
            v.cabecera.set_margin_top(18)
        return False


class Visualizador(Gtk.DrawingArea):
    """Barras que bailan con lo que suena (cava, solo mientras suena Nocturno),
    con su reflejo debajo, en el acento del tema. Tecla V: encender/apagar."""

    def __init__(self, ventana):
        super().__init__(content_height=46, hexpand=True)
        self.v = ventana
        self.objetivo = [0.0] * BARRAS
        self.ahora = [0.0] * BARRAS
        self.proc = None
        self.tic = None
        self.set_draw_func(self._pintar)

    # cava -------------------------------------------------------------
    def arrancar(self):
        if self.proc is not None:
            return
        if PRUEBA:      # niveles inventados: un bajo que late y medios que bailan
            self.proc = "prueba"
            self.t_prueba = 0

            def latir():
                if self.proc != "prueba":
                    return False
                self.t_prueba += 1
                t = self.t_prueba
                bajo = 0.85 if t % 15 < 3 else 0.2
                self.objetivo = [max(0.0, min(1.0, (bajo if i < 6 else 0.45 * abs(math.sin(t * 0.21 + i * 0.7))
                                                    * (1 - i / 50)))) for i in range(BARRAS)]
                return True

            GLib.timeout_add(33, latir)
            self._animar()
            return
        CACHE.mkdir(parents=True, exist_ok=True)
        conf = CACHE / "cava.conf"
        conf.write_text(f"""[general]
bars = {BARRAS}
framerate = 30
autosens = 1
[input]
method = pulse
source = auto
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10
[smoothing]
noise_reduction = 60
""")
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        try:
            self.proc = subprocess.Popen(["cava", "-p", str(conf)], stdout=subprocess.PIPE,
                                         stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                         preexec_fn=lambda: libc.prctl(1, signal.SIGTERM))
        except OSError:
            self.proc = None
            return
        threading.Thread(target=self._leer, args=(self.proc,), daemon=True).start()
        self._animar()

    def parar(self):
        if self.proc == "prueba":
            self.proc = None
        elif self.proc is not None:
            self.proc.terminate()
            self.proc = None
        self.objetivo = [0.0] * BARRAS   # caen suavemente hasta 0

    def _leer(self, proc):
        for linea in proc.stdout:
            try:
                n = [int(x) / 100 for x in linea.decode().strip().split(";") if x]
            except ValueError:
                continue
            if len(n) == BARRAS:
                GLib.idle_add(self._nuevos, n)

    def _nuevos(self, n):
        if self.proc is not None:
            self.objetivo = n
        return False

    # dibujo -----------------------------------------------------------
    def _animar(self):
        if self.tic is None:
            self.tic = self.add_tick_callback(self._paso)

    def _paso(self, _w, reloj):
        # a 30 fps, lo que da cava: a 60 se redibujaba el doble para nada
        # (28 % de un núcleo solo las barras; a 30, la mitad)
        t = reloj.get_frame_time()
        if t - getattr(self, "ultimo", 0) < 30_000:
            return GLib.SOURCE_CONTINUE
        self.ultimo = t
        quieto = True
        for i in range(BARRAS):
            d = self.objetivo[i] - self.ahora[i]
            self.ahora[i] += d * (0.6 if d > 0 else 0.3)     # sube rápido, cae despacio
            if abs(d) > 0.004:
                quieto = False
        self.queue_draw()
        if quieto and self.proc is None:
            self.tic = None
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    def _pintar(self, _area, cr, ancho, alto):
        r, g, b = rgb(self.v.colores["acento"])
        hueco = 3
        w = (ancho - hueco * (BARRAS - 1)) / BARRAS
        medio = alto * 0.72
        # rectángulos sin redondear y un solo fill por color: con 80 esquinas
        # redondeadas por fotograma, cairo se llevaba buena parte de la CPU
        for i, nivel in enumerate(self.ahora):
            h = max(2.0, nivel * (medio - 2))
            cr.rectangle(i * (w + hueco), medio - h, w, h)
        cr.set_source_rgba(r, g, b, 0.95)
        cr.fill()
        for i, nivel in enumerate(self.ahora):
            cr.rectangle(i * (w + hueco), medio + 2, w, max(1.0, nivel * (alto - medio - 2)))
        cr.set_source_rgba(r, g, b, 0.28)   # reflejo
        cr.fill()


def redondo(cr, x, y, w, h, rad):
    rad = min(rad, h / 2, w / 2)
    cr.new_sub_path()
    cr.arc(x + w - rad, y + rad, rad, -1.5708, 0)
    cr.arc(x + w - rad, y + h - rad, rad, 0, 1.5708)
    cr.arc(x + rad, y + h - rad, rad, 1.5708, 3.1416)
    cr.arc(x + rad, y + rad, rad, 3.1416, 4.7124)
    cr.close_path()


class Entrada:
    contador = 0

    def __init__(self, ruta):
        Entrada.contador += 1
        self.id = Entrada.contador
        self.ruta = ruta


def boton(icono, clase="plano", tam=18):
    b = Gtk.Button()
    b.add_css_class(clase)
    img = Gtk.Image.new_from_icon_name(icono)
    img.set_pixel_size(tam)
    b.set_child(img)
    b.set_focusable(False)
    b.set_valign(Gtk.Align.CENTER)
    return b


def poner_icono(b, icono):
    b.get_child().set_from_icon_name(icono)


class Ventana(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Nocturno")
        self.set_default_size(480, 840)
        self.set_decorated(False)  # sin barra de título, como el resto en niri
        self.add_css_class("musica")
        self.modo = "no"            # visualización: "no", "portada" o "cine"
        self.pagina = "vacia"       # lo que enseña la carátula cuando no hay visualización
        self.clic_pendiente = None
        self.pie_oculto = None

        self.lista = []           # [Entrada] en el orden en que suenan
        self.original = []        # el mismo, sin barajar
        self.etiquetas = {}       # ruta → {titulo, artista, album, duracion}
        self.filas = {}           # id → (fila, num, titulo, artista, dur)
        self.pos = -1
        self.pausa = False
        self.parado = True        # mpv sin nada cargado (al empezar o al acabar)
        self.tiempo = 0.0
        self.duracion = None
        # el volumen se recuerda entre aperturas (lo único de la sesión que se guarda)
        guardado = leer_json(PREFERENCIAS).get("volumen", 100)
        self.volumen = float(os.environ.get("NOCTURNO_VOLUMEN", guardado))
        self.guardar_vol = None
        self.silencio = False
        self.aleatorio = False
        self.repetir = 0          # 0 no, 1 la lista, 2 la canción
        self.ultimo_salto = 0.0
        self.portada_de = None    # ruta cuya carátula se ve
        self.art_url = ""

        self.mpv = Mpv(self.al_cambiar_mpv, self.volumen)
        self.mpv.observar("playlist-pos", "pause", "idle-active", "time-pos", "duration",
                          "volume", "mute")
        self.mpris = None
        con = app.get_dbus_connection()
        if con is not None:
            try:
                self.mpris = Mpris(self, con)
            except GLib.Error as e:
                print("MPRIS no disponible:", e.message, file=sys.stderr)

        self._construir()
        self._teclas()
        self._soltar()
        self._pintar_reproductor()

    # ------------------------------------------------------------ interfaz
    def _construir(self):
        # Todo el reproductor va en una columna de ANCHO px centrada: así la
        # barra, los botones y la lista tienen los mismos bordes aunque la
        # ventana se ensanche. Muy ancha (≥ ANCHO_DOBLE), la lista pasa a la
        # derecha (Raiz cambia de orientación).
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, width_request=ANCHO,
                       halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        self.columna = caja
        self.zona_lista = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, vexpand=True,
                                  width_request=ANCHO, halign=Gtk.Align.CENTER)
        raiz = Raiz(self)
        raiz.set_margin_top(28)
        raiz.set_margin_bottom(12)
        raiz.set_margin_start(24)
        raiz.set_margin_end(24)
        raiz.append(caja)
        raiz.append(self.zona_lista)
        # Dentro de un ScrolledWindow «EXTERNAL» (sin barras): la ventana no
        # impone ancho mínimo. Si no, la vista ancha (≈ 900 px de mínimo)
        # impedía a niri volver a estrecharla y se quedaba atascada a medias.
        marco = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.EXTERNAL,
                                   vscrollbar_policy=Gtk.PolicyType.EXTERNAL)
        marco.set_child(raiz)
        # Capas: [visualización de fondo] + [velo] + contenido + sensor de tamaño.
        # El contenido es el que da el tamaño (set_measure_overlay); el fondo
        # se pone luego (self.peli aún no existe aquí).
        capas = Gtk.Overlay()
        self.capas = capas
        capas.set_child(Gtk.Box())
        self.velo = Gtk.Box(can_target=False, visible=False)
        self.velo.add_css_class("velo")
        capas.add_overlay(self.velo)
        capas.add_overlay(marco)
        capas.set_measure_overlay(marco, True)
        capas.add_overlay(raiz.sensor)
        self.escenario = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                                   transition_duration=250)
        self.escenario.add_named(capas, "normal")
        self.set_child(self.escenario)
        self.connect("notify::fullscreened", self._al_cambiar_pantalla)

        # carátula (o el aviso de lista vacía)
        self.pila = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.pila.add_css_class("portada")
        self.pila.set_overflow(Gtk.Overflow.HIDDEN)
        self.lado = tamano_portada()
        self.pila.set_size_request(self.lado, self.lado)
        self.pila.set_halign(Gtk.Align.CENTER)
        vacia = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER)
        vacia.add_css_class("portada-vacia")
        icono = Gtk.Image.new_from_icon_name("folder-music-symbolic")
        icono.set_pixel_size(72)
        vacia.append(icono)
        aviso = Gtk.Label(label="Suelta canciones aquí\no ábrelas desde Archivos",
                          justify=Gtk.Justification.CENTER)
        vacia.append(aviso)
        self.pila.add_named(vacia, "vacia")
        sin = Gtk.Image.new_from_icon_name("audio-x-generic-symbolic")
        sin.set_pixel_size(96)
        sin.add_css_class("portada-vacia")
        self.pila.add_named(sin, "sin")
        # Gtk.Image con pixel_size y no Gtk.Picture: Picture pide el tamaño de
        # la imagen y la carátula crecía más de lo que cabe
        self.foto = Gtk.Image()
        self.foto.set_pixel_size(self.lado)
        self.pila.add_named(self.foto, "foto")
        caja.append(self.pila)
        self.peli = Pelicula(self) if np is not None else None
        if self.peli:
            # hueco transparente: con la visualización, la carátula se va y su
            # sitio sigue respondiendo al clic (para volver a ella)
            # (aquí hubo un selector «‹ escena ›» a la vista: el usuario prefirió
            # que no estuviera; se cambia con clic derecho o con ↑ ↓)
            self.pila.add_named(Gtk.Box(), "hueco")
            self.capas.set_child(self.peli.portada)
            # clic derecho en cualquier parte del fondo → menú de escenas
            fondo_clic = Gtk.GestureClick(button=3)
            fondo_clic.connect("pressed", self._clic_derecho_fondo)
            self.capas.add_controller(fondo_clic)
            self.pila.set_tooltip_text("Clic: visualización de fondo · Doble clic: pantalla completa"
                                       " · Clic derecho: elegir visualización")
            self.pila.set_cursor_from_name("pointer")
            clic = Gtk.GestureClick(button=0)
            clic.connect("pressed", self._clic_portada)
            self.pila.add_controller(clic)

        # título y artista
        # max_width_chars=1: si no, un título largo pide su ancho entero y
        # ensancha la columna en vez de cortarse con «…»
        self.titulo = Gtk.Label(xalign=0.5, ellipsize=Pango.EllipsizeMode.END,
                                max_width_chars=1, hexpand=True)
        self.titulo.add_css_class("titulo")
        self.titulo.set_margin_top(22)
        self.artista = Gtk.Label(xalign=0.5, ellipsize=Pango.EllipsizeMode.END,
                                 max_width_chars=1, hexpand=True)
        self.artista.add_css_class("artista")
        caja.append(self.titulo)
        caja.append(self.artista)

        # barra de progreso
        self.barra = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.001)
        self.barra.set_draw_value(False)
        self.barra.set_margin_top(10)
        self.barra.set_focusable(False)
        self.barra.connect("change-value", self._al_mover_barra)
        caja.append(self.barra)
        tiempos = Gtk.Box()
        self.t_ahora = Gtk.Label(label="0:00", xalign=0, hexpand=True)
        self.t_total = Gtk.Label(label="–:––", xalign=1)
        for t in (self.t_ahora, self.t_total):
            t.add_css_class("tiempo")
            tiempos.append(t)
        caja.append(tiempos)

        # controles
        fila = Gtk.CenterBox()
        fila.set_margin_top(6)
        centro = Gtk.Box(spacing=18)
        self.b_ant = boton("media-skip-backward-symbolic", tam=22)
        # Play/Pausa dibujados a mano: el triángulo de Papirus sale 4 px a la
        # izquierda y 4 px arriba dentro del círculo
        self.b_play = Gtk.Button(focusable=False, valign=Gtk.Align.CENTER)
        self.b_play.add_css_class("reproducir")
        self.icono_play = IconoPlay(self)
        self.b_play.set_child(self.icono_play)
        self.b_sig = boton("media-skip-forward-symbolic", tam=22)
        self.b_ant.connect("clicked", lambda *_: self.anterior())
        self.b_play.connect("clicked", lambda *_: self.reproducir_pausar())
        self.b_sig.connect("clicked", lambda *_: self.siguiente())
        self.b_alea, alea = self._con_punto("media-playlist-shuffle-symbolic")
        self.b_rep, rep = self._con_punto("media-playlist-repeat-symbolic")
        self.b_alea.set_tooltip_text("Aleatorio")
        self.b_alea.connect("clicked", lambda *_: self.cambiar_aleatorio())
        self.b_rep.connect("clicked", lambda *_: self.poner_repetir((self.repetir + 1) % 3))
        for w in (alea, self.b_ant, self.b_play, self.b_sig, rep):
            centro.append(w)
        fila.set_center_widget(centro)
        caja.append(fila)

        # volumen
        vol = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        vol.set_margin_top(8)
        self.b_vol = boton("audio-volume-high-symbolic", tam=16)
        self.b_vol.set_tooltip_text("Silenciar")
        self.b_vol.connect("clicked", lambda *_: self.mpv.poner("mute", not self.silencio))
        self.vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.vol.set_draw_value(False)
        self.vol.set_size_request(180, -1)
        self.vol.set_focusable(False)
        self.vol.set_value(self.volumen)
        self.vol.connect("change-value", lambda _s, _t, val: self.mpv.poner(
            "volume", max(0.0, min(100.0, val))) or False)
        hueco = Gtk.Box(width_request=36)
        vol.append(self.b_vol)
        vol.append(self.vol)
        vol.append(hueco)
        caja.append(vol)

        # visualizador (cava), debajo de los mandos
        self.visu = Visualizador(self)
        self.visu.set_margin_top(14)
        self.visu.set_visible(leer_json(PREFERENCIAS).get("visualizador", True))
        caja.append(self.visu)

        # lista
        self.cabecera = Gtk.Label(xalign=0)
        self.cabecera.add_css_class("cabecera")
        self.cabecera.set_margin_top(18)
        self.cabecera.set_margin_bottom(6)
        self.cabecera.set_margin_start(10)
        self.zona_lista.append(self.cabecera)
        # como Spotify: un clic marca la canción, doble clic la pone (con un
        # solo clic, el doble clic la ponía dos veces: arrancaba y volvía a empezar)
        self.caja_lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE,
                                      activate_on_single_click=False)
        self.caja_lista.add_css_class("lista")
        self.caja_lista.connect("row-activated", self._al_activar_fila)
        desliza = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        desliza.set_child(self.caja_lista)
        self.zona_lista.append(desliza)

        if self.peli:
            self._construir_cine()

        self._css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self._css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self._cargar_tema()
        self._vigilantes = []
        for archivo in (ESTADO / "tema/colores.json", ESTADO / "ajustes.json"):
            m = Gio.File.new_for_path(str(archivo)).monitor_file(Gio.FileMonitorFlags.NONE, None)
            m.connect("changed", lambda *_: self._cargar_tema())
            self._vigilantes.append(m)

    def _construir_cine(self):
        cine = Gtk.Overlay()
        cine.add_css_class("cine")
        cine.set_child(self.peli.cine)
        pie = Gtk.Box(valign=Gtk.Align.END, spacing=12)
        pie.add_css_class("cine-pie")
        self.pie_cancion = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END,
                                     max_width_chars=1)
        self.pie_cancion.add_css_class("cine-cancion")
        self.pie_escena = Gtk.Label(xalign=1)
        self.pie_escena.add_css_class("cine-escena")
        pie.append(self.pie_cancion)
        pie.append(self.pie_escena)
        self.pie = Gtk.Revealer(child=pie, valign=Gtk.Align.END, reveal_child=True,
                                transition_type=Gtk.RevealerTransitionType.CROSSFADE,
                                transition_duration=300)
        cine.add_overlay(self.pie)
        mover = Gtk.EventControllerMotion()
        mover.connect("motion", self._raton_cine)
        cine.add_controller(mover)
        clic = Gtk.GestureClick(button=0)
        clic.connect("pressed", self._clic_cine)
        cine.add_controller(clic)
        self.cine_caja = cine
        self.escenario.add_named(cine, "cine")
        self._pintar_pie()

    # ------------------------------------------------------ visualización
    def _clic_portada(self, gesto, n, x, y):
        if not self.lista or not self.peli:
            return
        boton_raton = gesto.get_current_button()
        if boton_raton == 3:
            if self.modo != "no":
                self._menu_visual(self.pila, x, y)
            return
        if boton_raton != 1:
            return
        if self.clic_pendiente is not None:
            GLib.source_remove(self.clic_pendiente)
            self.clic_pendiente = None
        if n >= 2:
            self.entrar_cine()
        else:
            # esperar por si es un doble clic (si no, el primer clic ya cambiaba)
            ajustes = Gtk.Settings.get_default()
            self.clic_pendiente = GLib.timeout_add(ajustes.props.gtk_double_click_time,
                                                   self._clic_simple)

    def _clic_derecho_fondo(self, _g, _n, x, y):
        if self.modo != "portada":
            return
        w = self.capas.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None:                 # sobre la lista: es «Quitar»
            if w is self.caja_lista or w is self.pila:
                return                       # (la carátula ya tiene el suyo)
            w = w.get_parent()
        self._menu_visual(self.capas, x, y)

    def otra_escena(self, paso):
        if not self.peli:
            return
        actual = next((i for i, e in enumerate(ESCENAS)
                       if isinstance(self.peli.motor.escena, e)), 0)
        self._elegir_escena(ESCENAS[(actual + paso) % len(ESCENAS)])

    def _clic_simple(self):
        self.clic_pendiente = None
        self.poner_modo("no" if self.modo == "portada" else "portada", guardar=True)
        return False

    def _clic_cine(self, gesto, n, x, y):
        b = gesto.get_current_button()
        if b == 3:
            self._menu_visual(self.cine_caja, x, y)
        elif b == 1 and n == 2:
            self.salir_cine()
        self._ensenar_pie()

    def poner_modo(self, modo, guardar=False):
        """guardar=True cuando lo decide el usuario: se recuerda para la próxima
        vez (si se apaga sola, p. ej. con la lista vacía, no cuenta)."""
        if not self.peli:
            return
        if guardar and modo in ("no", "portada"):
            self._guardar_pref("visualizacion", modo == "portada")
        antes = self.modo
        self.modo = modo
        if modo == "portada":   # «de fondo»: toda la ventana, la carátula se queda
            if antes == "cine":
                self.peli.quieto()
            self._tamano_fondo(self.get_width(), self.get_height())
            self.peli.portada.set_visible(True)
            self.velo.set_visible(True)
            self.add_css_class("con-fondo")
            self.pila.add_css_class("transparente")
            self.pila.set_visible_child_name("hueco")
        elif modo == "cine":
            self.peli.quieto()
            mon = self.get_display().get_monitor_at_surface(self.get_surface())
            geo = mon.get_geometry() if mon else None
            ancho, alto = (geo.width, geo.height) if geo else (16, 9)
            self.peli.tamano(480, max(120, round(480 * alto / ancho)))
            self.escenario.set_visible_child_name("cine")
            self._ensenar_pie()
        else:
            self.peli.quieto()
        if modo != "portada":
            self.peli.portada.set_visible(False)
            self.velo.set_visible(False)
            self.remove_css_class("con-fondo")
            self.pila.remove_css_class("transparente")
            self.pila.set_visible_child_name(self.pagina)
        if modo != "cine" and self.escenario.get_visible_child_name() == "cine":
            self.escenario.set_visible_child_name("normal")
            self.set_cursor(None)
        self.peli.mostrar()
        self._actualizar_animacion()

    def _tamano_fondo(self, ancho, alto):
        """La imagen del fondo, a la mitad de la ventana (máx. 400 de ancho):
        la GPU la escala suavizada, y así sale el resplandor de XP."""
        if not self.peli or ancho <= 0 or alto <= 0:
            return
        w = min(420, max(200, round(ancho * 0.45)))
        h = max(120, round(w * alto / ancho))
        # centro de la carátula dentro de la ventana (ya colocada)
        centro = (0.5, 0.3)
        ok, caja = self.pila.compute_bounds(self.capas)
        if ok and caja.get_width() > 0:
            centro = ((caja.get_x() + caja.get_width() / 2) / ancho,
                      (caja.get_y() + caja.get_height() / 2) / alto)
        # figuras grandes: que nazcan ya fuera de la carátula y lleguen a los
        # bordes de la ventana (con 1.0 quedaban escondidas detrás del disco)
        escala = max(1.0, self.lado * 1.4 / (min(ancho, alto) / 2))
        m = self.peli.motor
        clave = (w, h, round(centro[0], 3), round(centro[1], 3), round(escala, 3))
        if clave != getattr(self, "_clave_fondo", None):
            self._clave_fondo = clave
            self.peli.tamano(w, h, centro, escala)

    def entrar_cine(self):
        if not self.peli or not self.lista:
            return
        self.poner_modo("cine")
        self.fullscreen()

    def salir_cine(self):
        if self.modo == "cine":
            self.poner_modo("portada", guardar=True)
            self.unfullscreen()

    def _al_cambiar_pantalla(self, *_):
        # si niri la saca de pantalla completa por su cuenta (Mod+Shift+F...)
        if not self.is_fullscreen() and self.modo == "cine":
            self.poner_modo("portada")

    def _actualizar_animacion(self):
        sonando = not self.parado and not self.pausa
        if hasattr(self, "visu"):
            if sonando and (self.visu.get_visible() or self.modo != "no"):
                self.visu.arrancar()
            else:
                self.visu.parar()
        if self.peli:
            if self.modo == "no":
                self.peli.quieto()
            else:
                # al pausar, lo que hubiera se disipa hasta quedar a oscuras
                self.peli.animar(disipar=not sonando)

    def _raton_cine(self, _c, x, y):
        # GTK manda «motion» aunque el ratón esté quieto (al cambiar lo que
        # hay debajo): solo cuenta si se ha movido de verdad
        antes = getattr(self, "raton", None)
        self.raton = (x, y)
        if antes is not None and abs(antes[0] - x) + abs(antes[1] - y) > 3:
            self._ensenar_pie()

    def _ensenar_pie(self):
        if not hasattr(self, "pie"):
            return
        self.pie.set_reveal_child(True)
        self.cine_caja.set_cursor(None)
        if self.pie_oculto is not None:
            GLib.source_remove(self.pie_oculto)
        self.pie_oculto = GLib.timeout_add(2500, self._ocultar_pie)

    def _ocultar_pie(self):
        self.pie_oculto = None
        if self.modo == "cine":
            self.pie.set_reveal_child(False)
            self.cine_caja.set_cursor_from_name("none")
        return False

    def _pintar_pie(self):
        if not hasattr(self, "pie_cancion") or not self.peli:
            return
        e = self._actual()
        d = self.etiquetas.get(e.ruta, {}) if e else {}
        texto = d.get("titulo") or (Path(e.ruta).stem if e else "")
        if d.get("artista"):
            texto += f"  —  {d['artista']}"
        self.pie_cancion.set_label(texto)
        nombre = self.peli.motor.escena.nombre
        self.pie_escena.set_label(f"Nocturno: {nombre}" + ("  ·  aleatoria" if self.peli.aleatoria else ""))

    def _menu_visual(self, sobre, x, y):
        pop = Gtk.Popover(has_arrow=False)
        pop.add_css_class("menu-fila")
        pop.set_parent(sobre)
        pop.set_pointing_to(Gdk.Rectangle(int(x), int(y), 1, 1))
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        def opcion(texto, marcado, accion):
            b = Gtk.Button()
            etiqueta = Gtk.Label(label=("✓  " if marcado else "     ") + texto, xalign=0)
            b.set_child(etiqueta)

            def pulsar(*_):
                pop.popdown()
                GLib.idle_add(accion)

            b.connect("clicked", pulsar)
            caja.append(b)

        opcion("Aleatoria", self.peli.aleatoria, lambda: self._elegir_escena(None))
        for clase in ESCENAS:
            marcado = not self.peli.aleatoria and isinstance(self.peli.motor.escena, clase)
            opcion(clase.nombre.capitalize(), marcado, lambda c=clase: self._elegir_escena(c))
        caja.append(Gtk.Separator())
        if self.modo == "cine":
            opcion("Salir de pantalla completa", False, self.salir_cine)
        else:
            opcion("Pantalla completa", False, self.entrar_cine)
        opcion("Quitar la visualización", False, lambda: (self.unfullscreen(), self.poner_modo("no", guardar=True)))
        pop.set_child(caja)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    def _elegir_escena(self, clase):
        self.peli.aleatoria = clase is None
        self.peli.poner(clase or random.choice(ESCENAS))
        prefs = leer_json(PREFERENCIAS)
        prefs["escena"] = "aleatoria" if clase is None else clase.nombre
        try:
            PREFERENCIAS.write_text(json.dumps(prefs, indent=4) + "\n")
        except OSError:
            pass
        self.peli.mostrar()
        return False

    def _con_punto(self, icono):
        b = boton(icono, tam=18)
        cont = Gtk.Overlay(valign=Gtk.Align.CENTER)
        cont.set_child(b)
        punto = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.END)
        punto.set_margin_bottom(1)
        punto.add_css_class("punto")
        punto.set_visible(False)
        cont.add_overlay(punto)
        b.punto = punto
        return b, cont

    def _cargar_tema(self):
        # la variante oscura (o clara) de GTK según el fondo del tema: si no,
        # lo que no pinta nuestro CSS sale con texto negro del tema claro
        fondo = leer_json(ESTADO / "tema/colores.json").get("fondo", "#1a1b1e")
        try:
            r, g, b = (int(fondo[i:i + 2], 16) for i in (1, 3, 5))
            oscuro = 0.299 * r + 0.587 * g + 0.114 * b < 128
        except ValueError:
            oscuro = True
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", oscuro)
        self._css.load_from_string(css_del_tema())
        self.colores = colores_del_tema()
        if getattr(self, "peli", None):
            self.peli.colorear()
            self.peli.mostrar()
        if hasattr(self, "visu"):
            self.visu.queue_draw()
            self.icono_play.queue_draw()

    def _teclas(self):
        tec = Gtk.EventControllerKey()

        def pulsar(_c, tecla, _cod, estado):
            ctrl = estado & Gdk.ModifierType.CONTROL_MASK
            if tecla == Gdk.KEY_space:
                self.reproducir_pausar()
            elif ctrl and tecla in (Gdk.KEY_q, Gdk.KEY_w):
                self.close()
            elif tecla in (Gdk.KEY_v, Gdk.KEY_V):
                self.alternar_visualizador()
            elif tecla == Gdk.KEY_Right:
                self.mpv.orden("seek", 5, "relative")
            elif tecla in (Gdk.KEY_f, Gdk.KEY_F, Gdk.KEY_F11):
                self.salir_cine() if self.modo == "cine" else self.entrar_cine()
            elif tecla in (Gdk.KEY_Up, Gdk.KEY_Down) and self.modo != "no":
                self.otra_escena(-1 if tecla == Gdk.KEY_Up else 1)
            elif tecla == Gdk.KEY_Escape and self.modo == "cine":
                self.salir_cine()
            elif tecla == Gdk.KEY_Left:
                self.mpv.orden("seek", -5, "relative")
            else:
                return False
            return True

        tec.connect("key-pressed", pulsar)
        self.add_controller(tec)

    def _guardar_volumen_pronto(self):
        # al soltar la barra (medio segundo sin cambios), no en cada paso;
        # con NOCTURNO_VOLUMEN (pruebas) no se toca lo guardado
        if "NOCTURNO_VOLUMEN" in os.environ:
            return
        if self.guardar_vol is not None:
            GLib.source_remove(self.guardar_vol)
        self.guardar_vol = GLib.timeout_add(500, self._guardar_volumen)

    def _guardar_pref(self, clave, valor):
        prefs = leer_json(PREFERENCIAS)
        if prefs.get(clave) != valor:
            prefs[clave] = valor
            try:
                PREFERENCIAS.write_text(json.dumps(prefs, indent=4) + "\n")
            except OSError:
                pass

    def _guardar_volumen(self):
        self.guardar_vol = None
        prefs = leer_json(PREFERENCIAS)
        if prefs.get("volumen") != round(self.volumen):
            prefs["volumen"] = round(self.volumen)
            try:
                PREFERENCIAS.write_text(json.dumps(prefs, indent=4) + "\n")
            except OSError:
                pass
        return False

    def alternar_visualizador(self):
        ver = not self.visu.get_visible()
        self.visu.set_visible(ver)
        self._actualizar_animacion()
        prefs = leer_json(PREFERENCIAS)
        prefs["visualizador"] = ver
        try:
            PREFERENCIAS.write_text(json.dumps(prefs, indent=4) + "\n")
        except OSError:
            pass

    def _soltar(self):
        destino = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)

        def soltado(_d, valor, _x, _y):
            rutas = expandir([f.get_path() for f in valor.get_files() if f.get_path()])
            self.anadir(sorted(rutas, key=orden_natural))
            return True

        destino.connect("drop", soltado)
        self.add_controller(destino)

    # ------------------------------------------------------------ la lista
    def sustituir(self, rutas):
        if not rutas:
            return
        nuevas = [Entrada(r) for r in rutas]
        self.original = list(nuevas)
        if self.aleatorio and len(nuevas) > 1:
            resto = nuevas[1:]
            random.shuffle(resto)
            nuevas = [nuevas[0]] + resto
        self.lista = nuevas
        self.mpv.orden("loadfile", nuevas[0].ruta, "replace")
        for e in nuevas[1:]:
            self.mpv.orden("loadfile", e.ruta, "append")
        self.mpv.poner("pause", False)
        self._tras_cambiar_lista()

    def anadir(self, rutas):
        if not rutas:
            return
        if not self.lista:
            self.sustituir(rutas)
            return
        nuevas = [Entrada(r) for r in rutas]
        self.lista += nuevas
        self.original += nuevas
        for e in nuevas:
            self.mpv.orden("loadfile", e.ruta, "append")
        self._tras_cambiar_lista()

    def quitar(self, entrada):
        if entrada not in self.lista:
            return
        i = self.lista.index(entrada)
        self.mpv.orden("playlist-remove", i)
        self.lista.remove(entrada)
        self.original.remove(entrada)
        self._tras_cambiar_lista()

    def _reordenar(self, objetivo):
        """Mueve las entradas de mpv una a una hasta el orden pedido, sin
        cortar lo que suena."""
        sim = list(self.lista)
        for t, e in enumerate(objetivo):
            i = sim.index(e)
            if i != t:
                self.mpv.orden("playlist-move", i, t)
                sim.insert(t, sim.pop(i))
        self.lista = sim

    def cambiar_aleatorio(self):
        self.aleatorio = not self.aleatorio
        if self.lista:
            actual = self.lista[self.pos] if 0 <= self.pos < len(self.lista) else None
            if self.aleatorio:
                resto = [e for e in self.lista if e is not actual]
                random.shuffle(resto)
                self._reordenar(([actual] if actual else []) + resto)
            else:
                self._reordenar(list(self.original))
            self._tras_cambiar_lista()
        self._pintar_modos()
        if self.mpris:
            self.mpris.avisar("Shuffle")

    def poner_repetir(self, modo):
        self.repetir = modo
        self.mpv.poner("loop-playlist", "inf" if modo == 1 else "no")
        self.mpv.poner("loop-file", "inf" if modo == 2 else "no")
        self._pintar_modos()
        if self.mpris:
            self.mpris.avisar("LoopStatus")

    def _tras_cambiar_lista(self):
        # si la última vez se dejó la visualización puesta, vuelve en cuanto
        # hay canciones (sin canciones no se puede)
        if (self.lista and self.modo == "no" and self.peli
                and leer_json(PREFERENCIAS).get("visualizacion")):
            GLib.idle_add(lambda: self.modo == "no" and self.lista
                          and self.poner_modo("portada") and False)
        self._rehacer_filas()
        pendientes = [e.ruta for e in self.lista if e.ruta not in self.etiquetas]
        if pendientes:
            threading.Thread(target=self._leer_etiquetas, args=(pendientes,), daemon=True).start()
        self._pintar_reproductor()

    def _leer_etiquetas(self, rutas):
        for r in dict.fromkeys(rutas):
            datos = leer_etiquetas(r)
            GLib.idle_add(self._etiquetas_leidas, r, datos)

    def _etiquetas_leidas(self, ruta, datos):
        self.etiquetas[ruta] = datos
        for e in self.lista:
            if e.ruta == ruta and e.id in self.filas:
                _f, _n, t, a, d = self.filas[e.id]
                t.set_label(datos["titulo"])
                a.set_label(datos["artista"] or "Artista desconocido")
                d.set_label(mmss(datos["duracion"]))
        if self._actual() and self._actual().ruta == ruta:
            self._pintar_reproductor()
        self._pintar_cabecera()

    # ------------------------------------------------------------ las filas
    def _rehacer_filas(self):
        self.caja_lista.remove_all()
        self.filas = {}
        for i, e in enumerate(self.lista):
            datos = self.etiquetas.get(e.ruta, {})
            fila = Gtk.ListBoxRow()
            fila.entrada = e
            h = Gtk.Box(spacing=14)
            num = Gtk.Label(label=str(i + 1), width_chars=2, xalign=1)
            num.add_css_class("fila-num")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
            t = Gtk.Label(label=datos.get("titulo", Path(e.ruta).stem), xalign=0,
                          ellipsize=Pango.EllipsizeMode.END, max_width_chars=1)
            t.add_css_class("fila-titulo")
            a = Gtk.Label(label=datos.get("artista") or ("Artista desconocido" if datos else ""),
                          xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1)
            a.add_css_class("fila-artista")
            v.append(t)
            v.append(a)
            d = Gtk.Label(label=mmss(datos.get("duracion")) if datos else "")
            d.add_css_class("fila-dur")
            h.append(num)
            h.append(v)
            h.append(d)
            fila.set_child(h)
            clic = Gtk.GestureClick(button=3)
            clic.connect("pressed", self._menu_fila, fila)
            fila.add_controller(clic)
            self.caja_lista.append(fila)
            self.filas[e.id] = (fila, num, t, a, d)
        self._pintar_sonando()
        self._pintar_cabecera()

    def _pintar_cabecera(self):
        n = len(self.lista)
        if not n:
            self.cabecera.set_label("")
            return
        total = sum((self.etiquetas.get(e.ruta, {}).get("duracion") or 0) for e in self.lista)
        texto = "1 CANCIÓN" if n == 1 else f"{n} CANCIONES"
        if total:
            texto += f"  ·  {mmss(total)}"
        self.cabecera.set_label(texto)

    def _pintar_sonando(self):
        actual = self._actual() if not self.parado else None
        for i, e in enumerate(self.lista):
            if e.id not in self.filas:
                continue
            fila, num, *_ = self.filas[e.id]
            if e is actual:
                fila.add_css_class("sonando")
                num.set_label("♪" if not self.pausa else str(i + 1))
            else:
                fila.remove_css_class("sonando")
                num.set_label(str(i + 1))

    def _menu_fila(self, gesto, _n, x, y, fila):
        pop = Gtk.Popover(has_arrow=False)
        pop.add_css_class("menu-fila")
        pop.set_parent(fila)
        pop.set_pointing_to(Gdk.Rectangle(int(x), int(y), 1, 1))
        b = Gtk.Button(label="Quitar de la lista")

        def quitar(*_):
            pop.popdown()
            GLib.idle_add(self.quitar, fila.entrada)

        b.connect("clicked", quitar)
        pop.set_child(b)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    def _al_activar_fila(self, _caja, fila):
        if fila.entrada in self.lista:
            self.mpv.orden("playlist-play-index", self.lista.index(fila.entrada))
            self.mpv.poner("pause", False)

    # ------------------------------------------------------------ mandos
    def _actual(self):
        if 0 <= self.pos < len(self.lista):
            return self.lista[self.pos]
        return self.lista[0] if self.lista else None

    def reproducir(self):
        if not self.lista:
            return
        if self.parado:
            # acabada la lista, se vuelve a empezar por la primera
            i = 0 if self.pos >= len(self.lista) - 1 else max(self.pos, 0)
            self.mpv.orden("playlist-play-index", i)
        self.mpv.poner("pause", False)

    def reproducir_pausar(self):
        if self.parado or self.pausa:
            self.reproducir()
        else:
            self.mpv.poner("pause", True)

    def siguiente(self):
        if self.lista:
            self.mpv.orden("playlist-next", "weak")

    def anterior(self):
        if not self.lista:
            return
        if (self.tiempo or 0) > 3 or self.pos <= 0:
            self.mpv.orden("seek", 0, "absolute")
        else:
            self.mpv.orden("playlist-prev", "weak")

    def _al_mover_barra(self, _s, _tipo, valor):
        if self.duracion:
            self.ultimo_salto = time.monotonic()
            self.mpv.orden("seek", max(0.0, min(1.0, valor)) * self.duracion, "absolute")
        return False

    # ------------------------------------------------------------ mpv → UI
    def al_cambiar_mpv(self, nombre, valor):
        if nombre == "playlist-pos":
            nueva = valor if isinstance(valor, int) else -1
            if nueva >= 0 or self.parado:
                self.pos = nueva
            self._pintar_reproductor()
            self._pintar_sonando()
            if self.mpris:
                self.mpris.avisar("Metadata", "PlaybackStatus")
        elif nombre == "pause":
            self.pausa = bool(valor)
            self._pintar_play()
            self._pintar_sonando()
        elif nombre == "idle-active":
            self.parado = bool(valor)
            if self.parado:
                self.tiempo = 0.0
                self.barra.set_value(0)
                self.t_ahora.set_label("0:00")
            self._pintar_play()
            self._pintar_sonando()
        elif nombre == "time-pos":
            self.tiempo = valor or 0.0
            if time.monotonic() - self.ultimo_salto > 0.6:
                if self.duracion:
                    self.barra.set_value(self.tiempo / self.duracion)
                self.t_ahora.set_label(mmss(self.tiempo))
        elif nombre == "duration":
            self.duracion = valor
            self.t_total.set_label(mmss(valor))
        elif nombre == "volume":
            self.volumen = valor or 0.0
            self.vol.set_value(self.volumen)
            self._pintar_volumen()
            self._guardar_volumen_pronto()
            if self.mpris:
                self.mpris.avisar("Volume")
        elif nombre == "mute":
            self.silencio = bool(valor)
            self._pintar_volumen()
        return False

    def estado_mpris(self):
        if self.parado or not self.lista:
            return "Stopped"
        return "Paused" if self.pausa else "Playing"

    def metadatos_mpris(self):
        e = self._actual()
        if e is None:
            return {"mpris:trackid": GLib.Variant("o", "/org/mpris/MediaPlayer2/TrackList/NoTrack")}
        d = self.etiquetas.get(e.ruta, {"titulo": Path(e.ruta).stem})
        m = {
            "mpris:trackid": GLib.Variant("o", f"/org/yoru/nocturno/pista/{e.id}"),
            "xesam:title": GLib.Variant("s", d.get("titulo") or Path(e.ruta).stem),
            "xesam:url": GLib.Variant("s", Gio.File.new_for_path(e.ruta).get_uri()),
        }
        if d.get("artista"):
            m["xesam:artist"] = GLib.Variant("as", [d["artista"]])
        if d.get("album"):
            m["xesam:album"] = GLib.Variant("s", d["album"])
        dur = self.duracion or d.get("duracion")
        if dur:
            m["mpris:length"] = GLib.Variant("x", int(dur * 1e6))
        if self.art_url and self.portada_de == e.ruta:
            m["mpris:artUrl"] = GLib.Variant("s", self.art_url)
        return m

    def _pintar_play(self):
        sonando = not self.parado and not self.pausa
        self._actualizar_animacion()
        self.icono_play.poner(sonando)
        if self.mpris:
            self.mpris.avisar("PlaybackStatus")

    def _pintar_modos(self):
        self.b_alea.punto.set_visible(self.aleatorio)
        if self.aleatorio:
            self.b_alea.add_css_class("activo")
        else:
            self.b_alea.remove_css_class("activo")
        poner_icono(self.b_rep, "media-playlist-repeat-song-symbolic" if self.repetir == 2
                    else "media-playlist-repeat-symbolic")
        self.b_rep.set_tooltip_text(["Repetir: no", "Repetir la lista", "Repetir la canción"][self.repetir])
        self.b_rep.punto.set_visible(self.repetir > 0)
        if self.repetir:
            self.b_rep.add_css_class("activo")
        else:
            self.b_rep.remove_css_class("activo")

    def _pintar_volumen(self):
        v = 0 if self.silencio else self.volumen
        icono = ("audio-volume-muted-symbolic" if v <= 0 else
                 "audio-volume-low-symbolic" if v < 34 else
                 "audio-volume-medium-symbolic" if v < 67 else "audio-volume-high-symbolic")
        poner_icono(self.b_vol, icono)

    def _pagina(self, nombre):
        self.pagina = nombre
        if self.modo != "portada":     # con la visualización, la carátula no está
            self.pila.set_visible_child_name(nombre)

    def _pintar_reproductor(self):
        e = self._actual()
        self._pintar_modos()
        self._pintar_play()
        if e is None:
            self.poner_modo("no") if self.modo != "no" else None
            self._pagina("vacia")
            self.titulo.set_label("Nocturno")
            self.artista.set_label("Nada en la lista")
            self.t_total.set_label("–:––")
            self.portada_de = None
            self._pintar_cabecera()
            return
        d = self.etiquetas.get(e.ruta, {})
        self.titulo.set_label(d.get("titulo") or Path(e.ruta).stem)
        self.artista.set_label(" · ".join(x for x in (d.get("artista"), d.get("album")) if x))
        self.set_title(f"{self.titulo.get_label()} — Nocturno")
        self._pintar_pie()
        if self.portada_de != e.ruta:
            self.portada_de = e.ruta
            threading.Thread(target=self._buscar_portada, args=(e.ruta,), daemon=True).start()

    def _buscar_portada(self, ruta):
        datos = leer_portada(ruta)
        GLib.idle_add(self._portada_lista, ruta, datos)

    def _portada_lista(self, ruta, datos):
        if ruta != self.portada_de:
            return False
        self.art_url = ""
        textura = textura_cuadrada(datos, self.lado * self.get_scale_factor()) if datos else None
        if textura is not None:
            self.foto.set_from_paintable(textura)
            self._pagina("foto")
            try:
                CACHE.mkdir(parents=True, exist_ok=True)
                archivo = CACHE / (hashlib.md5(datos).hexdigest() + ".img")
                if not archivo.exists():
                    archivo.write_bytes(datos)
                self.art_url = archivo.as_uri()
            except OSError:
                pass
        else:
            self._pagina("sin")
        if self.mpris:
            self.mpris.avisar("Metadata")
        return False


# ------------------------------------------------------------------------ app
class Nocturno(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.ventana = None
        self.ultima_tanda = 0.0
        GLib.set_application_name("Nocturno")

    def _ventana(self):
        if self.ventana is None:
            self.ventana = Ventana(self)
            self.ventana.connect("close-request", self._al_cerrar)
        return self.ventana

    def do_startup(self):
        Gtk.Application.do_startup(self)
        # Acciones publicadas por D-Bus (org.gtk.Actions en /org/yoru/Nocturno):
        # sirven para atajos de niri y para probar sin ratón, p. ej.
        #   gdbus call --session -d org.yoru.Nocturno -o /org/yoru/Nocturno \
        #     -m org.gtk.Actions.Activate pantalla-completa [] {}
        for nombre, hacer in (("visualizacion", self._accion_visual),
                              ("pantalla-completa", self._accion_cine)):
            a = Gio.SimpleAction.new(nombre, None)
            a.connect("activate", hacer)
            self.add_action(a)
        esc = Gio.SimpleAction.new("escena", GLib.VariantType.new("s"))
        esc.connect("activate", self._accion_escena)
        self.add_action(esc)

    def _accion_visual(self, *_):
        v = self.ventana
        if v and v.lista and v.peli:
            if v.modo == "cine":
                v.salir_cine()
            v.poner_modo("no" if v.modo == "portada" else "portada", guardar=True)

    def _accion_cine(self, *_):
        v = self.ventana
        if v:
            v.salir_cine() if v.modo == "cine" else v.entrar_cine()

    def _accion_escena(self, _a, param):
        v = self.ventana
        if v and v.peli:
            nombre = param.unpack()
            v._elegir_escena(next((e for e in ESCENAS if e.nombre == nombre), None))

    def do_activate(self):
        self._ventana().present()

    def do_open(self, archivos, _n, _pista):
        v = self._ventana()
        rutas = sorted(expandir([f.get_path() for f in archivos if f.get_path()]), key=orden_natural)
        ahora = time.monotonic()
        if ahora - self.ultima_tanda < JUNTAR_SEGUNDOS:
            v.anadir(rutas)       # misma tanda (el gestor manda los archivos de uno en uno)
        else:
            v.sustituir(rutas)
        self.ultima_tanda = ahora
        v.present()

    def _al_cerrar(self, v):
        if v.guardar_vol is not None:
            GLib.source_remove(v.guardar_vol)
            v._guardar_volumen()
        v.visu.parar()
        v.mpv.apagar()
        self.ventana = None
        return False

    def do_shutdown(self):
        if self.ventana is not None:
            self.ventana.mpv.apagar()
        Gtk.Application.do_shutdown(self)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(Nocturno().run(sys.argv))
