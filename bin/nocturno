#!/usr/bin/env python3
# ============================================================================
#  Nocturno — el reproductor de música de Yoru (Yoru, 夜, es «noche»; un
#  nocturno, una pieza para la noche)
# ----------------------------------------------------------------------------
#  Una ventana GTK4 con un mpv detrás (hablan por su socket IPC). Cómo se
#  comporta (contrato acordado con el usuario el 2026-11-19):
#    · Una sola ventana. Abrir canciones con la app abierta no abre otra: se
#      las pasa a la que ya está (GApplication por D-Bus) y la trae delante.
#    · Abrir canciones = sustituir la lista y sonar al momento. Si llegan
#      varias tandas casi a la vez (< 0,25 s, hay gestores que mandan una por
#      archivo), se juntan en la misma lista.
#    · Una canción abierta = solo esa canción en la lista.
#    · Arrastrar a la ventana = añadir al final.
#    · Cerrar la ventana = para la música y no queda nada (ni procesos ni
#      lista guardada). Al abrirla de nuevo, empieza limpia.
#    · Al acabar la lista, se para en la última.
#  Colores y letra: los del tema de Yoru (~/.local/state/yoru/tema/
#  colores.json y ajustes.json); cambia solo al cambiar de tema.
#  Sale en la isla de la barra porque habla MPRIS (org.mpris.MediaPlayer2).
#
#  Pruebas: NOCTURNO_VOLUMEN=0 nocturno canción.flac
# ============================================================================

import base64
