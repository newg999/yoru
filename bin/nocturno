except ImportError:  # sin mutagen funciona igual, pero con el nombre del archivo
    mutagen = None

# NOCTURNO_PRUEBA=1: otra app aparte (no toca la ventana del usuario), ajustes
# en la caché y audio inventado para el visualizador (no hace falta sonido)
PRUEBA = bool(os.environ.get("NOCTURNO_PRUEBA"))
APP_ID = "org.yoru.NocturnoPrueba" if PRUEBA else "org.yoru.Nocturno"
EXTENSIONES = {".mp3", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".wav",
               ".aif", ".aiff", ".wma", ".ape", ".wv", ".mka", ".alac"}
NOMBRES_PORTADA = ("cover", "folder", "front", "album", "portada", "caratula")
ESTADO = Path.home() / ".local/state/yoru"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "nocturno"
# Tandas que llegan casi a la vez (< 0,25 s) son la misma selección: hay
# gestores de archivos que mandan los archivos de uno en uno, en milisegundos.
# Con 2 s, los dobles clics rápidos del usuario se iban poniendo en cola
JUNTAR_SEGUNDOS = 0.25
